---
import '../styles/global.css';
import { SITE_URL } from '../config';
import { DEFAULT_LOCALE, LOCALE_NAMES, LOCALES, localeOf, localePath, stripLocale, translator } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** False for pages that exist in one language only (the 404): no alternates, no language switch. */
  translated?: boolean;
}

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);
const { title, description = t('site.tagline'), translated = true } = Astro.props;
const fullTitle = title ? `${title} – ${t('site.name')}` : `${t('site.name')}: ${t('site.tagline')}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
/** The page's path in English (`/fr/learn` → `/learn`): the same page in every language. */
const page = stripLocale(path);
const pageUrl = new URL(path, SITE_URL).href;
const others = translated ? LOCALES.filter((l) => l !== locale) : [];
const alternates = translated ? LOCALES.map((l) => ({ hreflang: l, href: new URL(localePath(l, page), SITE_URL).href })) : [];
// Link previews (Open Graph, X): one image per language, made by scripts/og-image.ts.
const image = new URL(locale === DEFAULT_LOCALE ? '/og-image.png' : `/og-image-${locale}.png`, SITE_URL).href;

const nav = [
  { href: '/', label: t('site.nav.analyzer') },
  { href: '/find-my-csp', label: t('site.nav.find') },
  { href: '/learn', label: t('site.nav.learn') },
  { href: '/vendors', label: t('site.nav.vendors') },
  { href: '/about', label: t('site.nav.about') },
].map((item) => ({ ...item, current: page === item.href, href: localePath(locale, item.href) }));

const themes = [
  { id: 'system', label: t('site.theme.system'), icon: '<circle cx="8" cy="8" r="5.5"/><path d="M8 2.5v11a5.5 5.5 0 0 0 0-11z" class="filled"/>' },
  { id: 'light', label: t('site.theme.light'), icon: '<circle cx="8" cy="8" r="3"/><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1"/>' },
  { id: 'dark', label: t('site.theme.dark'), icon: '<path d="M13.5 9.5A5.5 5.5 0 1 1 6.5 2.5a4.5 4.5 0 0 0 7 7z"/>' },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE, page), SITE_URL).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={t('site.ogLocale')} />
    {others.map((l) => <meta property="og:locale:alternate" content={translator(l)('site.ogLocale')} />)}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t('site.name')}: ${t('site.tagline')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply the saved theme before the first paint (see the theme switch below).
      try {
        const theme = localStorage.getItem('csp-explained:theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body data-page={Astro.url.pathname}>
    <a class="skip visually-hidden" href="#main">{t('site.skip')}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={localePath(locale, '/')}>{t('site.name')}</a>
        <nav aria-label={t('site.navLabel')}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="theme-switch" role="radiogroup" aria-label={t('site.theme.label')} data-theme-switch hidden>
          {
            themes.map((theme) => (
              <button type="button" role="radio" aria-checked="false" data-value={theme.id} title={theme.label}>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <Fragment set:html={theme.icon} />
                </svg>
                <span class="visually-hidden">{theme.label}</span>
              </button>
            ))
          }
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-bar">
        <p class="muted">{t('site.footer')}</p>
        {
          others.length > 0 && (
            <nav class="lang-switch" aria-label={t('site.languageLabel')}>
              {others.map((l) => (
                <a href={localePath(l, page)} hreflang={l} lang={l} data-lang-switch>
                  {LOCALE_NAMES[l]}
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </footer>
  </body>
</html>

<script>
  import { track } from '../scripts/track';

  // A visit: this page was opened from outside the site (no cookie needed to tell).
  const from = document.referrer ? new URL(document.referrer).origin : '';
  if (from !== location.origin) track('visit', { page: document.body.dataset.page });

  // Language switch: the same page in the other language, keeping what follows the # (a shared policy, a tab).
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]')) {
    link.addEventListener('click', () => {
      link.hash = location.hash;
    });
  }

  // Theme switch: Auto follows the system; Light and Dark are remembered on this device.
  const KEY = 'csp-explained:theme';
  const root = document.documentElement;
  for (const group of document.querySelectorAll<HTMLElement>('[data-theme-switch]')) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
    const show = (value: string) => buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.value === value)));
    show(root.dataset.theme ?? 'system');
    group.hidden = false;
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const value = button.dataset.value ?? 'system';
        if (value === 'system') delete root.dataset.theme;
        else root.dataset.theme = value;
        try {
          if (value === 'system') localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, value);
        } catch {
          // Not remembered, but still applied for this visit.
        }
        show(value);
      });
    }
  }
</script>

<style>
  .skip:focus {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
  }
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
    padding-block: 1rem;
  }
  .bar nav {
    margin-left: auto;
  }
  .lang-switch a {
    color: var(--ink-soft);
    font-weight: 700;
    text-decoration: none;
  }
  .lang-switch a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .theme-switch {
    display: flex;
    gap: 0.15rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.15rem;
  }
  .theme-switch button {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-soft);
  }
  .theme-switch button:hover {
    color: var(--ink);
  }
  .theme-switch button[aria-checked='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .theme-switch svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-switch :global(.filled) {
    fill: currentColor;
    stroke: none;
  }
  .brand {
    font-weight: 800;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
    /* The brand is written like a highlighted token */
    background: linear-gradient(transparent 55%, var(--hl-keyword) 55%);
    padding-inline: 0.1em;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 700;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  main {
    padding-block: 2rem 4rem;
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem;
  }
  .site-footer p {
    margin: 0;
  }
  /* The footer line on the left, the other language on the right; stacked on narrow screens */
  .footer-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
</style>

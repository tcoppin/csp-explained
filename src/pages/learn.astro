---
import Base from '../layouts/Base.astro';
import { Rich } from '../components/Rich';
import { translatorFor } from '../i18n';

const t = translatorFor(Astro);
const words = t.keys('pages.learn.words');
---

<Base title={t('pages.learn.title')} description={t('pages.learn.description')}>
  <article class="wrap prose learn">
    <h1>{t('pages.learn.heading')}</h1>
    <p class="lead"><Rich t={t} msg="pages.learn.lead" /></p>

    <figure class="example">
      <div class="example-policy">
        <p><code><span class="tok tok-directive">script-src</span> <span class="tok hl-keyword">'self'</span> <span class="tok hl-host">https://www.googletagmanager.com</span>;</code></p>
        <p><code><span class="tok tok-directive">img-src</span> <span class="tok hl-keyword">'self'</span> <span class="tok hl-scheme">data:</span>;</code></p>
      </div>
      <figcaption>
        <p><Rich t={t} msg="pages.learn.exampleLine1" /><br /><Rich t={t} msg="pages.learn.exampleLine2" /></p>
      </figcaption>
    </figure>

    <h2>{t('pages.learn.whyTitle')}</h2>
    <p><Rich t={t} msg="pages.learn.why1" /></p>
    <p><Rich t={t} msg="pages.learn.why2" /></p>

    <h2>{t('pages.learn.toolsTitle')}</h2>
    <p><Rich t={t} msg="pages.learn.tools1" /></p>
    <p><Rich t={t} msg="pages.learn.tools2" /></p>

    <h2>{t('pages.learn.wordsTitle')}</h2>
    <dl class="glossary">
      {
        words.map((key) => (
          <>
            <dt><Rich t={t} msg={`${key}.term`} /></dt>
            <dd><Rich t={t} msg={`${key}.definition`} /></dd>
          </>
        ))
      }
    </dl>

    <h2>{t('pages.learn.askTitle')}</h2>
    <ol class="steps">
      <li><Rich t={t} msg="pages.learn.ask1" /></li>
      <li><Rich t={t} msg="pages.learn.ask2" /></li>
      <li><Rich t={t} msg="pages.learn.ask3" /></li>
    </ol>
  </article>
</Base>

<style>
  .learn {
    max-width: 52rem;
  }
  .learn h2 {
    margin-top: 2.5rem;
  }
  .lead {
    font-size: var(--step-1);
  }
  .example {
    margin: 2rem 0;
  }
  .example-policy {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    font-size: var(--step-0);
    line-height: 2;
    overflow-x: auto;
  }
  .example-policy p {
    margin: 0;
    max-width: none;
  }
  /* Long hosts wrap on phones rather than hiding behind a sideways scroll. */
  .example-policy code {
    overflow-wrap: anywhere;
  }
  .tok {
    font-family: var(--mono);
    border-radius: 3px;
    padding: 0.05em 0.25em;
  }
  .tok-directive {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .hl-keyword {
    background: var(--hl-keyword);
  }
  .hl-host {
    background: var(--hl-host);
  }
  .hl-scheme {
    background: var(--hl-scheme);
  }
  figcaption {
    margin-top: 0.75rem;
  }
  .glossary dt {
    font-weight: 700;
    margin-top: 1rem;
  }
  .glossary dd {
    margin: 0.25rem 0 0;
    max-width: var(--measure);
  }
  .steps li {
    margin-bottom: 0.4rem;
  }
</style>

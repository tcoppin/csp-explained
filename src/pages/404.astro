---
import Base from '../layouts/Base.astro';
import { translatorFor } from '../i18n';

const t = translatorFor(Astro);
---

<Base title={t('pages.notFound.title')}>
  <div class="wrap">
    <h1>{t('pages.notFound.heading')}</h1>
    <p>{t('pages.notFound.body')}</p>
    <p><a class="button" href="/">{t('pages.notFound.button')}</a></p>
  </div>
</Base>

---
import CodeBlock from '../../components/CodeBlock.astro';
import DevtoolsSketch from '../../components/DevtoolsSketch.astro';
import { Rich } from '../../components/Rich';
import Base from '../../layouts/Base.astro';
import { localeParams, localePath, translatorFor } from '../../i18n';
import { FIND_CSP_SNIPPET } from '../../lib/snippets/find-csp-console';

export function getStaticPaths() {
  return localeParams();
}

const t = translatorFor(Astro);
const m = (key: string) => `pages.find.${key}`;

const methods = [
  { id: 'console', hint: true },
  { id: 'devtools' },
  { id: 'source' },
  { id: 'terminal', hint: true },
  { id: 'errors' },
];

// Step numbers for the drawing: Network tab, the page's row, the response headers, the policy.
const browsers: { id: string; match?: string; steps: [number, number, number, number] }[] = [
  { id: 'chrome', steps: [1, 3, 4, 5] },
  { id: 'firefox', match: 'firefox|fxios', steps: [1, 3, 4, 5] },
  { id: 'safari', match: '^((?!chrome|chromium|crios|edg|android).)*safari', steps: [2, 3, 4, 4] },
];
const browser = (id: string, key: string) => m(`devtools.${id}.${key}`);
---

<Base title={t(m('title'))} description={t(m('description'))}>
  <div class="wrap prose guide">
    <h1>{t(m('title'))}</h1>
    <p class="lead"><Rich t={t} msg={m('lead')} /></p>

    <div class="methods" data-tabs data-tabs-hash>
      <div role="tablist" aria-label={t(m('methodsLabel'))} class="tablist" hidden>
        {
          methods.map((method, i) => (
            <button type="button" role="tab" id={`tab-${method.id}`} aria-controls={method.id} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="tab-label">{t(m(`methods.${method.id}.label`))}</span>
              {method.hint && <span class="tab-hint">{t(m(`methods.${method.id}.hint`))}</span>}
            </button>
          ))
        }
      </div>

      <section id="console" class="method">
        <h2>{t(m('console.title'))}</h2>
        <p><Rich t={t} msg={m('console.intro')} /></p>
        <ol class="steps">
          <li><Rich t={t} msg={m('console.step1')} /></li>
          <li><Rich t={t} msg={m('console.step2')} /></li>
          <li><Rich t={t} msg={m('console.step3')} /></li>
          <li>
            <Rich t={t} msg={m('console.step4')} />
            <CodeBlock id="snippet" caption={t(m('console.snippetCaption'))} code={FIND_CSP_SNIPPET} track="copy-snippet" />
          </li>
          <li><Rich t={t} msg={m('console.step5')} /></li>
        </ol>

        <p class="note"><Rich t={t} msg={m('console.note')} /></p>

        <details class="more">
          <summary>{t(m('console.safeQuestion'))}</summary>
          <p><Rich t={t} msg={m('console.safeAnswer')} /></p>
        </details>
        <details class="more">
          <summary>{t(m('console.syncQuestion'))}</summary>
          <p><Rich t={t} msg={m('console.syncAnswer')} /></p>
        </details>

        <details class="more">
          <summary>{t(m('console.refusedQuestion'))}</summary>
          <p><Rich t={t} msg={m('console.refusedAnswer')} /></p>
        </details>
      </section>

      <section id="devtools" class="method">
        <h2>{t(m('devtools.title'))}</h2>
        <p><Rich t={t} msg={m('devtools.intro')} /></p>

        <div class="browsers" data-tabs data-tabs-detect>
          <div role="tablist" aria-label={t(m('devtools.browserLabel'))} class="segmented" hidden>
            {
              browsers.map((b, i) => (
                <button type="button" role="tab" id={`tab-${b.id}`} aria-controls={`browser-${b.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-match={b.match}>
                  {t(browser(b.id, 'label'))}
                </button>
              ))
            }
          </div>
          {
            browsers.map((b) => (
              <div id={`browser-${b.id}`} class="browser">
                <h3>{t(browser(b.id, 'label'))}</h3>
                <ol class="steps">
                  {t.keys(browser(b.id, 'steps')).map((step) => (
                    <li><Rich t={t} msg={step} /></li>
                  ))}
                </ol>
                <DevtoolsSketch
                  browser={t(browser(b.id, 'sketch.browser'))}
                  type={t(browser(b.id, 'sketch.type'))}
                  section={t(browser(b.id, 'sketch.section'))}
                  steps={b.steps}
                />
              </div>
            ))
          }
        </div>
        <p class="note"><Rich t={t} msg={m('devtools.note')} /></p>
      </section>

      <section id="source" class="method">
        <h2>{t(m('source.title'))}</h2>
        <p><Rich t={t} msg={m('source.intro')} /></p>
        <ol class="steps">
          {t.keys(m('source.steps')).map((step) => (
            <li><Rich t={t} msg={step} /></li>
          ))}
        </ol>
      </section>

      <section id="terminal" class="method">
        <h2>{t(m('terminal.title'))}</h2>
        <p><Rich t={t} msg={m('terminal.intro')} /></p>
        <CodeBlock caption={t(m('terminal.caption'))} code="curl -sI https://www.example.com | grep -i content-security-policy" />
        <details class="more">
          <summary>{t(m('terminal.whereQuestion'))}</summary>
          <ul>
            {t.keys(m('terminal.where')).map((item) => (
              <li><Rich t={t} msg={item} /></li>
            ))}
          </ul>
        </details>
      </section>

      <section id="errors" class="method">
        <h2>{t(m('errors.title'))}</h2>
        <p><Rich t={t} msg={m('errors.intro')} /></p>
        {/* Browsers write this message in English whatever their language, so it isn't translated. */}
        <pre class="error-sample"><code>Refused to load the script 'https://cdn.vendor.example/tag.js' because it violates the following Content Security Policy directive: "script-src 'self' https://www.googletagmanager.com".</code></pre>
        <dl class="reading">
          <dt>{t(m('errors.blockedTerm'))}</dt>
          <dd><Rich t={t} msg={m('errors.blocked')} /></dd>
          <dt>{t(m('errors.ruleTerm'))}</dt>
          <dd><Rich t={t} msg={m('errors.rule')} /></dd>
          <dt>{t(m('errors.allowsTerm'))}</dt>
          <dd><Rich t={t} msg={m('errors.allows')} /></dd>
        </dl>
        <p class="note"><Rich t={t} msg={m('errors.note')} /></p>
      </section>
    </div>

    <section class="pitfalls" aria-labelledby="pitfalls-title">
      <h2 id="pitfalls-title">{t(m('pitfalls.title'))}</h2>
      <dl>
        {
          t.keys(m('pitfalls.items')).map((item) => (
            <>
              <dt>{t(`${item}.term`)}</dt>
              <dd><Rich t={t} msg={`${item}.definition`} /></dd>
            </>
          ))
        }
      </dl>
      <p><a class="button" href={localePath(t.locale, '/')}>{t(m('pitfalls.button'))}</a></p>
    </section>
  </div>
</Base>

<script>
  import '../../scripts/tabs';
</script>

<style>
  .guide {
    max-width: 56rem;
  }
  .lead {
    font-size: var(--step-1);
  }

  /* Method tabs */
  .tablist {
    display: flex;
    gap: 0 1.5rem;
    border-bottom: 2px solid var(--rule);
    margin-top: 2rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tablist [role='tab'] {
    flex: none;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    background: none;
    padding: 0.6rem 0 0.55rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink-soft);
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .tablist [role='tab']:hover {
    color: var(--ink);
  }
  .tablist [role='tab'][aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .tablist [aria-selected='true'] .tab-label {
    background: linear-gradient(transparent 58%, var(--hl-keyword) 58%, var(--hl-keyword) 92%, transparent 92%);
  }
  @media (max-width: 40rem) {
    .tablist {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 1rem;
    }
    .tablist [role='tab'] {
      font-size: var(--step-0);
      flex-wrap: wrap;
    }
  }
  .tab-hint {
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--ink-soft);
  }

  .method {
    margin-top: 3rem;
    scroll-margin-top: 1rem;
  }
  .tabs-ready > .method {
    margin-top: 0;
    padding-top: 1.75rem;
  }
  /* With tabs, the tab already names the method */
  .tabs-ready > .method > h2,
  .browsers.tabs-ready .browser > h3 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .steps {
    padding-left: 1.4rem;
    max-width: var(--measure);
  }
  .steps li {
    margin-bottom: 0.6rem;
    padding-left: 0.25rem;
  }
  kbd {
    border: 1px solid var(--rule);
    border-bottom-width: 3px;
    border-radius: 4px;
    padding: 0 0.35em;
    background: var(--surface);
    white-space: nowrap;
  }
  .note {
    border-left: 4px solid var(--hl-nonce);
    padding-left: 0.75rem;
  }
  .more {
    margin-top: 0.75rem;
    max-width: var(--measure);
  }
  .more summary {
    cursor: pointer;
    color: var(--action);
    font-weight: 700;
  }
  .more[open] summary {
    margin-bottom: 0.5rem;
  }

  /* Browser switch inside the Network tab method */
  .segmented {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }
  .segmented [role='tab'] {
    border: 2px solid var(--rule);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 0.2rem 0.7rem;
    font-weight: 700;
  }
  .segmented [role='tab'][aria-selected='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }
  .browsers:not(.tabs-ready) {
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .error-sample {
    border-left: 4px solid var(--bad);
    white-space: pre-wrap;
  }
  .reading,
  .pitfalls dl {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) 1fr;
    gap: 0.6rem 1.5rem;
    max-width: 52rem;
  }
  .reading dt,
  .pitfalls dt {
    font-weight: 700;
  }
  .reading dd,
  .pitfalls dd {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .reading,
    .pitfalls dl {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .reading dd,
    .pitfalls dd {
      margin-bottom: 0.75rem;
    }
  }
  .pitfalls {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid var(--rule);
  }
  .pitfalls h2 {
    font-size: var(--step-1);
  }
</style>

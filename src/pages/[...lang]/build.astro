---
import Builder from '../../components/builder/Builder';
import Base from '../../layouts/Base.astro';
import { localeOf, localeParams, translatorFor } from '../../i18n';
import { contentFor } from '../../lib/site-content';

export function getStaticPaths() {
  return localeParams();
}

const t = translatorFor(Astro);
const locale = localeOf(Astro.currentLocale);
---

<Base title={t('pages.build.title')} description={t('pages.build.description')}>
  <div class="wrap">
    <h1>{t('pages.build.title')}</h1>
    <p class="lead">{t('pages.build.lead')}</p>
    <Builder client:load content={contentFor(locale)} locale={locale} />
  </div>
</Base>

<style>
  .lead {
    font-size: var(--step-1);
    max-width: var(--measure);
  }
</style>

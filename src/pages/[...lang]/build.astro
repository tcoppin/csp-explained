---
import BuilderEn from '../../components/builder/Builder.en';
import BuilderFr from '../../components/builder/Builder.fr';
import Base from '../../layouts/Base.astro';
import { localeOf, localeParams, translatorFor } from '../../i18n';

export function getStaticPaths() {
  return localeParams();
}

const t = translatorFor(Astro);
const locale = localeOf(Astro.currentLocale);
---

<Base title={t('pages.build.title')} description={t('pages.build.description')}>
  <div class="wrap">
    <h1>{t('pages.build.title')}</h1>
    <p class="lead">{t('pages.build.lead')}</p>
    {/* Its content comes from a cached module per language, not a prop written into the page. */}
    {locale === 'fr' ? <BuilderFr client:load /> : <BuilderEn client:load />}
  </div>
</Base>

<style>
  .lead {
    font-size: var(--step-1);
    max-width: var(--measure);
  }
</style>

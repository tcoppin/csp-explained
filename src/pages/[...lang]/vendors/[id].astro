---
import Base from '../../../layouts/Base.astro';
import CodeBlock from '../../../components/site/CodeBlock.astro';
import { NewTabLink } from '../../../components/ui/NewTabLink';
import { Rich } from '../../../components/ui/Rich';
import { outdatedIssueUrl } from '../../../config';
import { DEFAULT_LOCALE, localeOf, localeParams, localePath, translatorFor } from '../../../i18n';
import { requirementsOf } from '../../../lib/catalogue/requirements';
import type { Feature } from '../../../lib/catalogue/schema';
import { CANONICAL_DIRECTIVE } from '../../../lib/csp/directives';
import { contentFor } from '../../../lib/site-content';

export function getStaticPaths() {
  return localeParams().flatMap(({ params }) => contentFor(DEFAULT_LOCALE).vendors.map((vendor) => ({ params: { ...params, id: vendor.id } })));
}

// The page's language decides the text; the facts are the same in every language.
const vendor = contentFor(localeOf(Astro.currentLocale)).vendors.find((v) => v.id === Astro.params.id)!;
const t = translatorFor(Astro);
const m = (key: string) => `pages.vendors.${key}`;

/** The directive lines a feature needs, grouped as people would write them. */
function linesFor(feature: Feature): string[] {
  const byDirective = new Map<string, string[]>();
  for (const r of requirementsOf(feature)) {
    const d = CANONICAL_DIRECTIVE[r.type];
    const values = byDirective.get(d) ?? [];
    if (!values.includes(r.source)) values.push(r.source);
    byDirective.set(d, values);
  }
  return [...byDirective].map(([d, values]) => `${d} ${values.join(' ')};`);
}

/** The highlighter colour of a source, as in the analyzer. */
const hl = (src: string) =>
  src.startsWith("'unsafe-") || src === '*' ? 'hl-unsafe' : src.startsWith("'") ? 'hl-keyword' : /^[a-z]+:$/.test(src) ? 'hl-scheme' : 'hl-host';

const date = new Intl.DateTimeFormat(t.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${vendor.lastVerified}T00:00:00Z`));

const checkLink = localePath(t.locale, `/#v=${vendor.id}:${vendor.features.filter((f) => f.default).map((f) => f.id).join('+')}`);
---

<Base title={t(m('vendorTitle'), { name: vendor.name })} description={t(m('vendorDescription'), { name: vendor.name })}>
  <article class="wrap prose page-column vendor-page">
    <p class="crumb"><a href={localePath(t.locale, '/vendors')}>{t('site.nav.vendors')}</a></p>
    <h1>{vendor.name}</h1>
    <p class="provenance">
      {vendor.confidence === 'verified' ? t('vendors.verified', { date }) : t('vendors.partial')}.
      {' '}
      {vendor.sources.map((s, i) => (
        <>
          {i > 0 && ' '}
          <NewTabLink t={t} href={s} label={t('vendors.sources') + (vendor.sources.length > 1 ? ` ${i + 1}` : '')} />
        </>
      ))}
    </p>
    <p><a class="button" href={checkLink}>{t(m('check'), { name: vendor.name })}</a></p>

    {vendor.notes && <p>{vendor.notes}</p>}

    {
      vendor.nonce?.how && (
        <section class="nonce">
          <h2>{t(m('nonceTitle'))}</h2>
          <p>{vendor.nonce.how}</p>
        </section>
      )
    }

    {
      vendor.features.map((f) => (
        <section>
          <h2>{f.label}</h2>
          {f.description && <p>{f.description}</p>}
          <CodeBlock code={linesFor(f).join('\n')} caption={t(m('addToPolicy'))}>
            <ol class="annotated">
              {f.requirements.map((r) => (
                <li>
                  <span class="note">{t(`resources.${r.type}`)}</span>
                  <div>
                    <code class="tokens">
                      <span class="tok tok-directive">{CANONICAL_DIRECTIVE[r.type]}</span>
                      {r.sources.map((src) => (
                        <>
                          {' '}
                          <span class={`tok ${hl(src)}`}>{src}</span>
                        </>
                      ))}
                    </code>
                    <p class="why">{r.reason}</p>
                  </div>
                </li>
              ))}
            </ol>
          </CodeBlock>
        </section>
      ))
    }

    <p class="muted">
      <Rich t={t} msg={m('outdated')} vars={{ url: outdatedIssueUrl(vendor.id, vendor.name) }} />
    </p>
  </article>
</Base>

<style>
  .vendor-page section {
    margin-top: 2.5rem;
  }
  .crumb {
    margin-bottom: 0.25rem;
  }
  .provenance {
    color: var(--ink-soft);
  }
  .nonce {
    border-left: 4px solid var(--hl-nonce);
    padding-left: 1rem;
  }
  /* The highlighters, as in the analyzer */
  .tok {
    font-family: var(--mono);
    border-radius: 3px;
    padding: 0.05em 0.25em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .tok-directive {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .hl-keyword {
    background: var(--hl-keyword);
  }
  .hl-host {
    background: var(--hl-host);
  }
  .hl-scheme {
    background: var(--hl-scheme);
  }
  .hl-unsafe {
    background: var(--hl-unsafe);
  }
  /* Each line of the policy with what it's for, like the analyzer's annotated policy */
  .annotated {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
  }
  .annotated li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.4rem 1rem;
    align-items: baseline;
  }
  .annotated .note {
    color: var(--ink-soft);
    font-size: var(--step--1);
    text-align: right;
    border-right: 2px solid var(--rule);
    padding-right: 1rem;
  }
  .annotated .tokens {
    line-height: 2;
    overflow-wrap: anywhere;
    font-size: var(--step-0);
  }
  .annotated .why {
    margin: 0.1rem 0 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  @media (max-width: 40rem) {
    .annotated li {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .annotated .note {
      text-align: left;
      border: 0;
      padding: 0;
    }
  }
</style>

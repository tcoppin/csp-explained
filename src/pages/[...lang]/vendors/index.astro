---
import Base from '../../../layouts/Base.astro';
import { Rich } from '../../../components/ui/Rich';
import { REPO_URL } from '../../../config';
import { groupByCategory } from '../../../lib/catalogue/categories';
import { requirementsOf } from '../../../lib/catalogue/requirements';
import type { Vendor } from '../../../lib/catalogue/schema';
import { CANONICAL_DIRECTIVE } from '../../../lib/csp/directives';
import { parseHostSource } from '../../../lib/csp/parser';
import { localeOf, localeParams, localePath, translatorFor } from '../../../i18n';
import { contentFor } from '../../../lib/site-content';

export function getStaticPaths() {
  return localeParams();
}

const t = translatorFor(Astro);
const m = (key: string) => `pages.vendors.${key}`;
const groups = groupByCategory(contentFor(localeOf(Astro.currentLocale)).vendors, t);
const date = (d: string) =>
  new Intl.DateTimeFormat(t.locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`));

/** What a tool's default setup needs: its directives, and the 'unsafe-…' keywords it asks for. */
function needs(v: Vendor) {
  const defaults = v.features.filter((f) => f.default);
  const requirements = (defaults.length > 0 ? defaults : v.features.slice(0, 1)).flatMap((f) => requirementsOf(f));
  return {
    directives: [...new Set(requirements.map((r) => CANONICAL_DIRECTIVE[r.type]))],
    unsafe: [...new Set(requirements.map((r) => r.source).filter((s) => s.startsWith("'unsafe-")))],
  };
}
const missingUrl = `${REPO_URL}/issues/new?labels=catalogue&title=Add%20a%20tool%3A%20`;

/**
 * Every address a tool lists, once per feature, with the directives it goes in: the lines the address search
 * shows (hidden until an address matches them).
 */
function uses(v: Vendor) {
  const lines = new Map<string, { source: string; feature: string; directives: string[] }>();
  for (const f of v.features) {
    for (const r of requirementsOf(f)) {
      if (!parseHostSource(r.source)?.host.includes('.')) continue;
      const key = `${f.id} ${r.source}`;
      const line = lines.get(key) ?? { source: r.source, feature: f.label, directives: [] };
      const directive = CANONICAL_DIRECTIVE[r.type];
      if (!line.directives.includes(directive)) line.directives.push(directive);
      lines.set(key, line);
    }
  }
  return [...lines.values()];
}
/** "{source} in {directives}, for {feature}." → its text and placeholders apart, so each placeholder can be an element. */
const useParts = t(m('use')).split(/(\{\w+\})/).filter(Boolean);
const directiveList = (names: string[]) => new Intl.ListFormat(t.locale, { type: 'conjunction' }).formatToParts(names);
---

<Base title={t(m('title'))} description={t(m('description'))}>
  <div class="wrap prose page-column catalogue">
    <h1>{t(m('heading'))}</h1>
    <p class="lead"><Rich t={t} msg={m('lead')} /></p>
    <p class="finder" data-finder hidden>
      <label for="find-tool">{t(m('find'))}</label>
      <input id="find-tool" type="search" autocomplete="off" spellcheck="false" placeholder={t(m('findPlaceholder'))} />
    </p>
    <p
      class="visually-hidden"
      role="status"
      data-status
      data-say-found={t(m('found'))}
      data-say-used-by={t(m('usedBy'))}
      data-say-near-found={t(m('nearFound'))}
      data-say-no-match={t(m('noMatch'))}
      data-say-no-address={t(m('noAddress'))}
    >
    </p>
    <p class="near" data-near data-template={t(m('near'))} hidden></p>
    {
      groups.map((g) => (
        <section data-group>
          <h2>{g.label}</h2>
          <ul class="tools">
            {g.vendors.map((v) => {
              const n = needs(v);
              const lines = uses(v);
              return (
                <li data-name={v.name.toLowerCase()} data-label={v.name}>
                  <div class="tool-head">
                    <a href={localePath(t.locale, `/vendors/${v.id}`)}>{v.name}</a>
                    <span class={v.confidence === 'verified' ? 'status' : 'status partial'}>
                      {t(m(v.confidence === 'verified' ? 'checked' : 'partial'), { date: date(v.lastVerified) })}
                    </span>
                  </div>
                  <p class="needs">
                    {n.directives.map((d) => (
                      <code class="chip">{d}</code>
                    ))}
                    {n.unsafe.map((u) => (
                      <code class="chip unsafe">{u}</code>
                    ))}
                    {v.nonce?.supported && <span class="nonce">{t(m('nonce'))}</span>}
                  </p>
                  {lines.length > 0 && (
                    <ul class="uses" data-uses hidden>
                      {lines.map((line) => (
                        <li data-source={line.source} hidden>
                          {useParts.map((part) =>
                            part === '{source}' ? (
                              <code class="host">{line.source}</code>
                            ) : part === '{directives}' ? (
                              directiveList(line.directives).map((p) => (p.type === 'element' ? <code class="chip">{p.value}</code> : p.value))
                            ) : part === '{feature}' ? (
                              line.feature
                            ) : (
                              part
                            ),
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
    <p class="muted" data-no-match hidden>{t(m('noMatch'))}</p>
    <section class="missing">
      <h2>{t(m('missingTitle'))}</h2>
      <p><Rich t={t} msg={m('missing')} vars={{ url: missingUrl }} /></p>
    </section>
  </div>
</Base>

<script>
  import { addressOf, sourceMatchesAddress } from '../../../lib/catalogue/lookup';

  // Find a tool by its name, or by an address it uses: hides the tools that don't match and the groups left empty.
  // For an address, each tool left shows the lines that cover it; when no tool uses the address itself, the tools
  // using addresses under it (google.com → www.google.com). Without JavaScript the field stays hidden and every
  // tool shows.
  const finder = document.querySelector<HTMLElement>('[data-finder]');
  const input = finder?.querySelector('input');
  const tools = [...document.querySelectorAll<HTMLElement>('[data-name]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const none = document.querySelector<HTMLElement>('[data-no-match]');
  const near = document.querySelector<HTMLElement>('[data-near]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const lang = document.documentElement.lang;
  const fill = (template: string, vars: Record<string, string>) => template.replace(/\{(\w+)\}/g, (m, k: string) => vars[k] ?? m);
  const list = (names: string[]) => new Intl.ListFormat(lang, { type: 'conjunction' }).format(names);
  let pending: number | undefined;

  function search(query: string): string {
    const address = addressOf(query);
    const lines = tools.map((tool) => [...tool.querySelectorAll<HTMLElement>('[data-source]')]);
    for (const line of lines.flat()) line.hidden = true;
    const kinds = address ? lines.map((ls) => ls.map((l) => sourceMatchesAddress(l.dataset.source!, address))) : [];
    const exact = kinds.some((ks) => ks.includes('exact'));
    const wanted = exact ? 'exact' : 'domain';

    tools.forEach((tool, i) => {
      if (!address) {
        tool.hidden = query !== '' && !tool.dataset.name!.includes(query.toLowerCase());
      } else {
        lines[i]!.forEach((line, j) => (line.hidden = kinds[i]![j] !== wanted));
        tool.hidden = !kinds[i]!.includes(wanted);
      }
      const uses = tool.querySelector<HTMLElement>('[data-uses]');
      if (uses) uses.hidden = !address || tool.hidden;
    });
    for (const g of groups) g.hidden = !g.querySelector('[data-name]:not([hidden])');

    const shown = tools.filter((tool) => !tool.hidden).map((tool) => tool.dataset.label!);
    const host = address?.host ?? '';
    if (near) {
      near.hidden = !address || exact || shown.length === 0;
      near.textContent = fill(near.dataset.template!, { address: host });
    }
    if (none) {
      none.hidden = shown.length > 0;
      none.textContent = fill(address ? status!.dataset.sayNoAddress! : status!.dataset.sayNoMatch!, { address: host });
    }
    if (!query) return '';
    if (shown.length === 0) return none!.textContent!;
    const template = !address ? status!.dataset.sayFound! : exact ? status!.dataset.sayUsedBy! : status!.dataset.sayNearFound!;
    return fill(template, { tools: list(shown), address: host });
  }

  if (finder && input && status) {
    finder.hidden = false;
    input.addEventListener('input', () => {
      const line = search(input.value.trim());
      // Said once typing pauses, not after every letter.
      window.clearTimeout(pending);
      pending = window.setTimeout(() => (status.textContent = line), 500);
    });
  }
</script>

<style>
  .lead {
    font-size: var(--step-1);
  }
  .finder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 1.5rem 0 0;
  }
  .finder label {
    font-weight: 700;
  }
  .finder input {
    flex: 1;
    min-width: 12rem;
    max-width: 24rem;
    border: 2px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    padding: 0.5rem 0.75rem;
    font: inherit;
  }
  .finder input:focus {
    border-color: var(--action);
    outline: none;
  }
  section {
    margin-top: 2.25rem;
  }

  /* One row per tool: its name and when it was checked, then what it needs */
  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tools li {
    max-width: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .tool-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .tool-head a {
    font-weight: 700;
    font-size: var(--step-1);
  }
  @media (pointer: coarse) {
    .tool-head a {
      padding-block: 0.35rem;
    }
  }
  .status {
    color: var(--ink-soft);
    font-size: var(--step--1);
    white-space: nowrap;
  }
  .status.partial {
    color: var(--warn);
    font-weight: 700;
  }
  .needs {
    margin: 0.35rem 0 0;
  }
  .chip {
    display: inline-block;
    white-space: nowrap;
    font-size: var(--step--1);
    padding: 0 0.35em;
    margin: 0.1rem 0.35rem 0.1rem 0;
    border-radius: 3px;
    background: var(--hl-invalid);
  }
  .chip.unsafe {
    background: var(--hl-unsafe);
  }
  .near {
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
  }
  /* The lines that cover the address searched for: the address highlighted, the rest quiet */
  .uses {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }
  .tools .uses li {
    padding: 0.15rem 0;
    border-bottom: none;
    overflow-wrap: anywhere;
  }
  /* In a sentence: no gap before the comma that follows, and no line break before it either (an inline-block
     lets the comma start the next line) */
  .uses .chip {
    display: inline;
    margin: 0;
  }
  .host {
    background: var(--hl-host);
    padding: 0 0.25em;
    border-radius: 3px;
  }
  .nonce {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--ok);
    white-space: nowrap;
  }

  .missing {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .missing h2 {
    font-size: var(--step-1);
  }
</style>

---
import Base from '../../../layouts/Base.astro';
import { Rich } from '../../../components/Rich';
import { REPO_URL } from '../../../config';
import { groupByCategory } from '../../../lib/catalogue/categories';
import { localeOf, localeParams, localePath, translatorFor } from '../../../i18n';
import { contentFor } from '../../../lib/site-content';

export function getStaticPaths() {
  return localeParams();
}

const t = translatorFor(Astro);
const groups = groupByCategory(contentFor(localeOf(Astro.currentLocale)).vendors, t);
---

<Base title={t('pages.vendors.title')} description={t('pages.vendors.description')}>
  <div class="wrap prose">
    <h1>{t('pages.vendors.heading')}</h1>
    <p class="lead"><Rich t={t} msg="pages.vendors.lead" /></p>
    {
      groups.map((g) => (
        <section>
          <h2>{g.label}</h2>
          <ul class="vendor-index">
            {g.vendors.map((v) => (
              <li>
                <a href={localePath(t.locale, `/vendors/${v.id}`)}>{v.name}</a>
                <span class="muted">
                  {v.confidence === 'verified' ? t('pages.vendors.checked', { date: v.lastVerified }) : t('pages.vendors.partial')}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <h2>{t('pages.vendors.missingTitle')}</h2>
    <p><Rich t={t} msg="pages.vendors.missing" vars={{ url: `${REPO_URL}/issues/new?labels=catalogue&title=Add%20a%20tool%3A%20` }} /></p>
  </div>
</Base>

<style>
  .lead {
    font-size: var(--step-1);
  }
  section {
    margin-top: 2rem;
  }
  .vendor-index {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 40rem;
  }
  .vendor-index li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .vendor-index a {
    font-weight: 700;
  }
</style>

---
import Base from '../../../layouts/Base.astro';
import { Rich } from '../../../components/Rich';
import { localeOf, localeParams, localePath, translatorFor } from '../../../i18n';
import { contentFor } from '../../../lib/site-content';
import { DIRECTIVES, type DirectiveInfo } from '../../../lib/csp/directives';

export function getStaticPaths() {
  return localeParams().flatMap(({ params }) =>
    [...DIRECTIVES.values()].map((info) => ({
      params: { ...params, name: info.name },
      props: { info },
    })),
  );
}

const { info } = Astro.props as { info: DirectiveInfo };
const doc = contentFor(localeOf(Astro.currentLocale)).directives[info.name]!;
const t = translatorFor(Astro);
const m = (key: string) => `pages.directives.${key}`;
// The linked list of directives goes where `{directives}` is in the sentence.
const [usedBefore, usedAfter] = t(m('usedInPlaceOf')).split('{directives}');
const mdn = `https://developer.mozilla.org/${t(m('mdnLocale'))}/docs/Web/HTTP/Reference/Headers/Content-Security-Policy/${info.name}`;
const fallsBackHere = [...DIRECTIVES.values()].filter((d) => d.fallback[0] === info.name).map((d) => d.name);
---

<Base title={`${info.name}: ${doc.title}`} description={doc.simple}>
  <article class="wrap prose directive-page">
    <p class="crumb"><a href={localePath(t.locale, '/directives')}>{t(m('all'))}</a></p>
    <h1><code>{info.name}</code></h1>
    <p class="title">{doc.title}</p>
    {info.deprecated && <p class="warn">{t(m('deprecated'))}</p>}

    <section>
      <h2>{t(m('simpleTitle'))}</h2>
      <p>{doc.simple}</p>
    </section>
    <section>
      <h2>{t(m('developerTitle'))}</h2>
      <p>{doc.developer}</p>
      <ul class="facts">
        <li>
          {
            info.fallback.length > 0 ? (
              <Rich t={t} msg={m('fallback')} vars={{ chain: info.fallback.join(' → ') }} />
            ) : (
              <Rich t={t} msg={m('noFallback')} />
            )
          }
        </li>
        {fallsBackHere.length > 0 && <li>{usedBefore}{fallsBackHere.map((n, i) => <>{i > 0 && ', '}<a href={localePath(t.locale, `/directives/${n}`)}><code>{n}</code></a></>)}{usedAfter}</li>}
        {info.ignoredInMeta && <li><Rich t={t} msg={m('ignoredInMeta')} /></li>}
      </ul>
    </section>
    <section>
      <h2>{t(m('securityTitle'))}</h2>
      <p>{doc.security}</p>
    </section>
    <p class="muted">
      <Rich t={t} msg={m('reference')} vars={{ url: mdn }} />
    </p>
  </article>
</Base>

<style>
  .directive-page {
    max-width: 52rem;
  }
  .directive-page section {
    margin-top: 2rem;
  }
  .crumb {
    margin-bottom: 0.25rem;
  }
  h1 {
    margin-bottom: 0;
  }
  h1 code {
    background: linear-gradient(transparent 55%, var(--hl-keyword) 55%);
  }
  .title {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .warn {
    border-left: 4px solid var(--warn);
    padding-left: 0.75rem;
  }
  .facts li {
    margin-bottom: 0.3rem;
  }
</style>

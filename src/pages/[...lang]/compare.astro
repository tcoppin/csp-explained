---
import CompareEn from '../../components/compare/Compare.en';
import CompareFr from '../../components/compare/Compare.fr';
import Base from '../../layouts/Base.astro';
import { localeOf, localeParams, translatorFor } from '../../i18n';

export function getStaticPaths() {
  return localeParams();
}

const t = translatorFor(Astro);
const locale = localeOf(Astro.currentLocale);
---

<Base title={t('pages.compare.title')} description={t('pages.compare.description')}>
  <div class="wrap">
    <h1>{t('pages.compare.title')}</h1>
    <p class="lead">{t('pages.compare.lead')}</p>
    {/* Its content comes from a cached module per language, not a prop written into the page. */}
    {locale === 'fr' ? <CompareFr client:load /> : <CompareEn client:load />}
  </div>
</Base>

<style>
  .lead {
    font-size: var(--step-1);
    max-width: var(--measure);
  }
</style>

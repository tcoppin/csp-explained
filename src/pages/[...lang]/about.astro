---
import Base from '../../layouts/Base.astro';
import { Rich } from '../../components/Rich';
import { encodeState } from '../../components/state';
import { REPO_URL } from '../../config';
import { localeParams, localePath, translatorFor } from '../../i18n';
import { HEADER_POLICY, META_DIRECTIVES } from '../../site-policy';

export function getStaticPaths() {
  return localeParams();
}

const t = translatorFor(Astro);
const metaPolicy = [...META_DIRECTIVES, "script-src 'self' 'sha256-…'", "style-src 'self' 'sha256-…'"].join('; ');
const ownPolicy = `Content-Security-Policy: ${HEADER_POLICY}\n<meta http-equiv="Content-Security-Policy" content="${metaPolicy}">`;
const analyzeOwn = localePath(t.locale, `/#${encodeState({ policy: ownPolicy, site: '', vendors: {} })}`);
---

<Base title={t('pages.about.title')} description={t('pages.about.description')}>
  <article class="wrap prose about">
    <h1>{t('pages.about.title')}</h1>
    <p class="lead"><Rich t={t} msg="pages.about.lead" /></p>

    <h2>{t('pages.about.privacyTitle')}</h2>
    <p><Rich t={t} msg="pages.about.privacy" /></p>

    <h2>{t('pages.about.countTitle')}</h2>
    <p><Rich t={t} msg="pages.about.count" /></p>

    <h2>{t('pages.about.sourcesTitle')}</h2>
    <ul>
      <li><Rich t={t} msg="pages.about.sourceSpec" /></li>
      <li><Rich t={t} msg="pages.about.sourceEvaluator" /></li>
      <li><Rich t={t} msg="pages.about.sourceVendors" /></li>
    </ul>

    <h2>{t('pages.about.catalogueTitle')}</h2>
    <p><Rich t={t} msg="pages.about.catalogue" vars={{ issues: `${REPO_URL}/issues` }} /></p>

    <h2>{t('pages.about.ownTitle')}</h2>
    <p><Rich t={t} msg="pages.about.own" /></p>
    <pre><code>{ownPolicy}</code></pre>
    <p><a class="button" href={analyzeOwn}>{t('pages.about.analyseOwn')}</a></p>
  </article>
</Base>

<style>
  .about {
    max-width: 52rem;
  }
  .about h2 {
    margin-top: 2.5rem;
  }
  .lead {
    font-size: var(--step-1);
  }
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  li {
    margin-bottom: 0.4rem;
  }
</style>

---
import ReportReaderEn from '../../components/violation-reports/ReportReader.en';
import ReportReaderFr from '../../components/violation-reports/ReportReader.fr';
import { Rich } from '../../components/ui/Rich';
import Base from '../../layouts/Base.astro';
import { localeOf, localeParams, translatorFor } from '../../i18n';

export function getStaticPaths() {
  return localeParams();
}

const t = translatorFor(Astro);
const locale = localeOf(Astro.currentLocale);
---

<Base title={t('pages.reports.title')} description={t('pages.reports.description')}>
  <div class="wrap">
    <h1>{t('pages.reports.heading')}</h1>
    <p class="lead"><Rich t={t} msg="pages.reports.lead" /></p>
    <p class="private"><Rich t={t} msg="pages.reports.private" /></p>
    {/* Its content comes from a cached module per language, not a prop written into the page. */}
    {locale === 'fr' ? <ReportReaderFr client:load /> : <ReportReaderEn client:load />}
  </div>
</Base>

<style>
  .lead {
    font-size: var(--step-1);
    max-width: var(--measure);
  }
  .private {
    max-width: var(--measure);
    color: var(--ink-soft);
  }
  /* Once reports are read, the introduction has done its job: the results start near the top. */
  .wrap:has(:global(.report-bar)) :is(.lead, .private) {
    display: none;
  }
</style>

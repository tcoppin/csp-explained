---
import Analyzer from '../../components/Analyzer';
import Base from '../../layouts/Base.astro';
import { LOCALES, localeOf, localeParams } from '../../i18n';
import { contentFor } from '../../lib/site-content';

export function getStaticPaths() {
  return localeParams();
}

const locale = localeOf(Astro.currentLocale);
const otherVendors = Object.fromEntries(LOCALES.filter((l) => l !== locale).map((l) => [l, contentFor(l).vendors]));
---

<Base>
  <div class="wrap">
    <Analyzer client:load content={contentFor(locale)} locale={locale} otherVendors={otherVendors} />
  </div>
</Base>

---
import AnalyzerEn from '../../components/analyzer/Analyzer.en';
import AnalyzerFr from '../../components/analyzer/Analyzer.fr';
import Base from '../../layouts/Base.astro';
import { localeOf, localeParams } from '../../i18n';

export function getStaticPaths() {
  return localeParams();
}

const locale = localeOf(Astro.currentLocale);
---

<Base>
  <div class="wrap">
    {/* Its content comes from a cached module per language, not a prop written into the page. */}
    {locale === 'fr' ? <AnalyzerFr client:load /> : <AnalyzerEn client:load />}
  </div>
</Base>

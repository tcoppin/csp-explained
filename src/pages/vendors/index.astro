---
import Base from '../../layouts/Base.astro';
import { REPO_URL } from '../../config';
import { groupByCategory } from '../../lib/catalogue/categories';
import { content } from '../../lib/content';

const groups = groupByCategory(content.vendors);
---

<Base title="Tools" description="What popular marketing and analytics tools need in your Content-Security-Policy, taken from their official documentation.">
  <div class="wrap prose">
    <h1>What each tool needs</h1>
    <p class="lead">
      Every entry comes from the vendor's official documentation, with the date it was last checked. Pick a tool to see what it
      needs, or check it against your own policy in the analyzer.
    </p>
    {
      groups.map((g) => (
        <section>
          <h2>{g.label}</h2>
          <ul class="vendor-index">
            {g.vendors.map((v) => (
              <li>
                <a href={`/vendors/${v.id}`}>{v.name}</a>
                <span class="muted">
                  {v.confidence === 'verified' ? `checked ${v.lastVerified}` : 'partially verified'}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <h2>Missing a tool?</h2>
    <p>
      The catalogue is open. <a href={`${REPO_URL}/issues/new?labels=catalogue&title=Add%20a%20tool%3A%20`}>Suggest a tool</a>
      with a link to its official CSP documentation.
    </p>
  </div>
</Base>

<style>
  .lead {
    font-size: var(--step-1);
  }
  section {
    margin-top: 2rem;
  }
  .vendor-index {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 40rem;
  }
  .vendor-index li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .vendor-index a {
    font-weight: 700;
  }
</style>

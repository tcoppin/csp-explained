---
import Base from '../../layouts/Base.astro';
import { content } from '../../lib/content';
import { translatorFor } from '../../i18n';
import { DIRECTIVES, type DirectiveCategory } from '../../lib/csp/directives';

const t = translatorFor(Astro);
const CATEGORIES: DirectiveCategory[] = ['fetch', 'document', 'navigation', 'reporting', 'other'];

const groups = CATEGORIES.map((c) => ({
  label: t(`pages.directives.categories.${c}`),
  items: [...DIRECTIVES.values()].filter((d) => d.category === c).sort((a, b) => Number(!!a.deprecated) - Number(!!b.deprecated)),
}));
---

<Base title={t('pages.directives.title')} description={t('pages.directives.description')}>
  <div class="wrap prose">
    <h1>{t('pages.directives.heading')}</h1>
    {
      groups.map((g) => (
        <section>
          <h2>{g.label}</h2>
          <dl>
            {g.items.map((d) => (
              <div class={d.deprecated ? 'deprecated' : undefined}>
                <dt>
                  <a href={`/directives/${d.name}`}>
                    <code>{d.name}</code>
                  </a>
                  <span class="muted"> {content.directives[d.name]?.title}</span>
                </dt>
                <dd>{content.directives[d.name]?.simple}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
</Base>

<style>
  section {
    margin-top: 2.5rem;
  }
  dl > div {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    max-width: 52rem;
  }
  dt a {
    font-weight: 700;
  }
  dd {
    margin: 0.25rem 0 0;
  }
  .deprecated {
    opacity: 0.7;
  }
</style>

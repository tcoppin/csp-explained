---
/*
 * Quick access in the right margin of a 56rem page column: the guides' "On this page", the catalogue's categories.
 * Shown from 80rem up, sticking under the header; narrower screens don't have the room. The parent must be
 * positioned (position: relative) and start at the column's left edge. The slot holds an <ol> of links, and may
 * end with a paragraph of other links.
 */
interface Props {
  title: string;
  /** Id of the title, which names the landmark. */
  titleId: string;
}
const { title, titleId } = Astro.props;
---

<aside class="margin-nav" aria-labelledby={titleId}>
  <div class="margin-nav-inner">
    <p id={titleId} class="margin-nav-title">{title}</p>
    <slot />
  </div>
</aside>

<style>
  .margin-nav {
    display: none;
  }
  @media (min-width: 80rem) {
    .margin-nav {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--gutter) + 56rem + 3rem);
      right: var(--gutter);
    }
    .margin-nav-inner {
      position: sticky;
      top: 5.5rem;
    }
    .margin-nav-title {
      font-size: var(--step--1);
      font-weight: 700;
      color: var(--ink-soft);
      margin: 0 0 0.5rem;
    }
    .margin-nav :global(ol) {
      list-style: none;
      margin: 0;
      padding: 0 0 0 1rem;
      border-left: 2px solid var(--rule);
    }
    .margin-nav :global(li) {
      padding-block: 0.3rem;
      font-size: var(--step--1);
    }
    .margin-nav :global(p:not(.margin-nav-title)) {
      margin: 1.25rem 0 0;
      font-size: var(--step--1);
    }
    .margin-nav :global(a) {
      color: var(--ink-soft);
      font-weight: 700;
      text-decoration: none;
    }
    .margin-nav :global(a:hover) {
      color: var(--ink);
    }
    .margin-nav :global(a[aria-current]) {
      color: var(--ink);
      background: linear-gradient(transparent 60%, var(--hl-keyword) 60%);
    }
  }
</style>

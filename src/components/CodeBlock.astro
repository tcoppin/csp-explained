---
/**
 * A block of code with a slim bar saying where to use it and a "Copy this" control.
 * The copy control needs JavaScript, so it stays hidden until the script below enables it.
 * Styles live in global.css (.code-block), shared with the CodeBox island component.
 */
interface Props {
  code: string;
  /** Where the code is meant to be used, e.g. "Paste into the browser console". */
  caption: string;
  id?: string;
  /** Usage event counted when the code is copied. */
  track?: 'copy-snippet';
}

const { code, caption, id, track } = Astro.props;
---

<figure class="code-block">
  <figcaption>
    <span>{caption}</span>
    <button type="button" class="copy" data-copy data-track={track} hidden>
      <svg class="icon icon-copy" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
        <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5"></path>
      </svg>
      <svg class="icon icon-done" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 8.5l3.2 3L13 4.5"></path>
      </svg>
      <span class="copy-label" aria-live="polite">Copy this</span>
    </button>
  </figcaption>
  <pre id={id}><code>{code}</code></pre>
</figure>

<script>
  import { track } from '../scripts/track';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.hidden = false;
    const label = button.querySelector('.copy-label');
    const code = button.closest('.code-block')?.querySelector('pre');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code?.textContent ?? '');
        if (button.dataset.track === 'copy-snippet') track('copy-snippet');
        button.classList.add('done');
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          button.classList.remove('done');
          if (label) label.textContent = 'Copy this';
        }, 1800);
      } catch {
        // Clipboard blocked: the code stays visible and selectable.
      }
    });
  }
</script>

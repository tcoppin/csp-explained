---
/**
 * A block of code with a slim bar saying where to use it and a "Copy this" control.
 * The copy control needs JavaScript, so it stays hidden until the script below enables it.
 */
interface Props {
  code: string;
  /** Where the code is meant to be used, e.g. "Paste into the browser console". */
  caption: string;
  id?: string;
}

const { code, caption, id } = Astro.props;
---

<figure class="code-block">
  <figcaption>
    <span>{caption}</span>
    <button type="button" class="copy" data-copy hidden>
      <svg class="icon icon-copy" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
        <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5"></path>
      </svg>
      <svg class="icon icon-done" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 8.5l3.2 3L13 4.5"></path>
      </svg>
      <span class="copy-label" aria-live="polite">Copy this</span>
    </button>
  </figcaption>
  <pre id={id}><code>{code}</code></pre>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.hidden = false;
    const label = button.querySelector('.copy-label');
    const code = button.closest('.code-block')?.querySelector('pre');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code?.textContent ?? '');
        button.classList.add('done');
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          button.classList.remove('done');
          if (label) label.textContent = 'Copy this';
        }, 1800);
      } catch {
        // Clipboard blocked: the code stays visible and selectable.
      }
    });
  }
</script>

<style>
  .code-block {
    margin: 0.75rem 0 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0.4rem 0.3rem 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  pre {
    margin: 0;
    border: 0;
    border-radius: 0;
    font-size: var(--step--1);
    /* Readers check what the code does: every line stays readable without sideways scrolling */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--action);
    font-size: var(--step--1);
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    white-space: nowrap;
  }
  .copy:hover {
    background: var(--paper);
  }
  .icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-done,
  .copy.done .icon-copy {
    display: none;
  }
  .copy.done {
    color: var(--ok);
  }
  .copy.done .icon-done {
    display: block;
  }
</style>
